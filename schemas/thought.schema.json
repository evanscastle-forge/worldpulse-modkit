{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://worldpulse.game/modapi/1/thought.schema.json",
  "title": "thought",
  "x-modApi": 1,
  "type": "object",
  "properties": {
    "label": {
      "type": "string",
      "default": ""
    },
    "mood": {
      "type": "integer",
      "default": 0
    },
    "ticks": {
      "type": "integer",
      "default": 6000
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+)+$"
    },
    "kind": {
      "const": "thought"
    }
  },
  "patternProperties": {
    "^_": {},
    "^\\$schema$": {}
  },
  "additionalProperties": false,
  "required": [
    "id",
    "kind"
  ]
}
