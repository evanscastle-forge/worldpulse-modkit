{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://worldpulse.game/modapi/1/animal.schema.json",
  "title": "animal",
  "x-modApi": 1,
  "type": "object",
  "properties": {
    "label": {
      "type": "string",
      "default": ""
    },
    "color": {
      "type": "string",
      "default": "#ff00ff"
    },
    "size": {
      "type": "integer",
      "default": 70
    },
    "maxHealth": {
      "type": "integer",
      "default": 50
    },
    "moveTicks": {
      "type": "integer",
      "default": 6
    },
    "damage": {
      "type": "integer",
      "default": 5
    },
    "attackTicks": {
      "type": "integer",
      "default": 50
    },
    "foodDecay": {
      "type": "integer",
      "default": 6
    },
    "diet": {
      "type": "string",
      "default": "grazer",
      "enum": [
        "grazer",
        "predator"
      ]
    },
    "meatYield": {
      "type": "integer",
      "default": 20
    },
    "meatItem": {
      "type": "string",
      "default": "core.item.meat",
      "x-ref": "item"
    },
    "minTemp": {
      "type": "integer",
      "default": -100
    },
    "maxTemp": {
      "type": "integer",
      "default": 100
    },
    "retaliate": {
      "type": "integer",
      "default": 0
    },
    "manhuntChance": {
      "type": "integer",
      "default": 0
    },
    "leatherYield": {
      "type": "integer",
      "default": 0
    },
    "leatherItem": {
      "type": "string",
      "default": "core.item.leather",
      "x-ref": "item"
    },
    "sprite": {
      "type": "string",
      "x-nullable": true,
      "x-ref": "sprite",
      "x-size": 16
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+)+$"
    },
    "kind": {
      "const": "animal"
    }
  },
  "patternProperties": {
    "^_": {},
    "^\\$schema$": {}
  },
  "additionalProperties": false,
  "required": [
    "id",
    "kind"
  ]
}
